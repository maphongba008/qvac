{
  "name": "pear-expo",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clean": "watchman watch-del $PWD; watchman watch-project $PWD && npm run start",
    "bundle:android": "./script/bundle_android.sh",
    "bundle:ios": "./script/bundle_ios.sh",
    "android": "npm run bundle-bare && expo run:android",
    "barelog": "adb logcat '*:S bare:*'",
    "ios": "npm run bundle-bare && expo run:ios",
    "bundle-bare": "npm run bundle:android && npm run bundle:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@react-native-picker/picker": "2.9.0",
    "b4a": "^1.6.7",
    "bare-fs": "^3.1.1",
    "bare-pack": "^1.1.4",
    "bare-path": "^3.0.0",
    "bare-runtime": "^1.11.1",
    "corestore": "^6.18.4",
    "events": "^3.3.0",
    "expo": "^52.0.11",
    "expo-asset": "~11.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.3",
    "expo-file-system": "~18.0.4",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-status-bar": "~2.0.0",
    "hyperbee": "^2.20.7",
    "hyperswarm": "^4.8.4",
    "qvac-lib-dl-hyperdrive": "file:qvac-lib-dl-hyperdrive-1.0.0.tgz",
    "qvac-lib-inference-addon-mlc-marian": "file:qvac-lib-inference-addon-mlc-marian-1.0.0.tgz",
    "qvac-mlc-model-addon": "file:qvac-mlc-model-addon-1.0.0.tgz",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-bare-kit": "^0.3.2",
    "react-native-picker-select": "^9.3.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
